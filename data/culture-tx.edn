#:culture{:id "kir.product.babai", :name "Babai (giant swamp taro)", :country "KIR", :kind :product, :summary "Giant swamp taro (Cyrtosperma merkusii), called babai in Kiribati, grown in purpose-built swamp pits dug below the freshwater lens; its cultivation has deep cultural significance in Kiribati.", :url "https://en.wikipedia.org/wiki/Cyrtosperma_merkusii", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
